# Server Port (defaults to 8080 if omitted)
PORT=8080

# Nodemailer Gmail SMTP Configuration
# NEVER commit the actual .env file or hardcode secrets into source files.
# If these variables are not provided, POST /api/send-email returns an email preview object instead.
# For Gmail, generate an App Password via Google Account -> Security -> 2-Step Verification -> App passwords.
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
